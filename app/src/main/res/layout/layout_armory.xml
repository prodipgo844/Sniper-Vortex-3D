<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gunmetal_black"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btn_armory_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/gunmetal_gray"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/tactical_green"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="TACTICAL ARMORY"
            android:textColor="@color/tactical_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>

        <!-- Clean header with no cash balance -->
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/gunmetal_light" />

    <!-- Weapons tabs container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/tab_weapon_m24"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tactical_green"
            android:text="M24"
            android:textColor="@color/gunmetal_black"
            android:textSize="11sp"
            android:padding="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/tab_weapon_awm"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/gunmetal_gray"
            android:text="AWM"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/tab_weapon_m200"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/gunmetal_gray"
            android:text="M200"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/tab_weapon_barrett"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/gunmetal_gray"
            android:text="M82"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:padding="2dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

    <!-- Weapon details card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gunmetal_gray"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_armory_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M24 SNIPER WEAPON SYSTEM"
                android:textColor="@color/tactical_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/txt_armory_equipped_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:background="@color/gunmetal_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="EQUIPPED"
                android:textColor="@color/tactical_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txt_armory_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Starter tactical rifle, highly reliable in simple operations."
            android:textColor="@color/matte_white"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Upgrades section -->
    <LinearLayout
        android:id="@+id/layout_upgrades_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPGRADE WEAPON SUB-SYSTEMS"
            android:textColor="@color/tactical_amber"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/container_upgrades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Inflate item_upgrade_row here in loop -->
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Unlocked buy triggers -->
    <LinearLayout
        android:id="@+id/layout_locked_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLASSIFIED ARSENAL SUBSYSTEM"
            android:textColor="@color/ghost_gray"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Unlock this high-impact military sniper rifle instantly."
            android:textColor="@color/ghost_gray"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btn_armory_unlock"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/tactical_amber"
            android:text="UNLOCK TACTICAL WEAPON"
            android:textColor="@color/gunmetal_black"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Master action triggers -->
    <Button
        android:id="@+id/btn_armory_equip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/tactical_green"
        android:text="EQUIP THIS SNIPER"
        android:textColor="@color/gunmetal_black"
        android:textStyle="bold" />

</LinearLayout>
