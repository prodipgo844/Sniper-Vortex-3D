<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@color/gunmetal_gray"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_upgrade_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAMAGE IMPACT (+15% / LVL)"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <!-- Progress block notches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <View
                android:id="@+id/notch_1"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@color/tactical_green"
                android:layout_marginEnd="4dp" />

            <View
                android:id="@+id/notch_2"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@color/black"
                android:layout_marginEnd="4dp" />

            <View
                android:id="@+id/notch_3"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@color/black"
                android:layout_marginEnd="4dp" />

            <View
                android:id="@+id/notch_4"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@color/black"
                android:layout_marginEnd="4dp" />

            <View
                android:id="@+id/notch_5"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:background="@color/black" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_upgrade_action"
        android:layout_width="96dp"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/tactical_amber"
        android:text="$250"
        android:textColor="@color/gunmetal_black"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <TextView
        android:id="@+id/txt_upgrade_maxed"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="MAX LEVEL"
        android:textColor="@color/tactical_green"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:fontFamily="monospace"/>

</LinearLayout>
